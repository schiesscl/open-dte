# VARIABLES DE ENTORNO PARA OPENDTE
# ========================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Rellena con tus datos de base de datos PostgreSQL y llaves
# 3. Mantén este archivo en Git SIN datos reales

# Clave secreta de Django (Genera una única para producción)
# Puedes generar una: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-generic-development-key-change-this-in-production

# Modo debug (True para desarrollo, False en producción)
DJANGO_DEBUG=True

# Hosts permitidos separados por coma
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# === CONFIGURACIÓN BASE DE DATOS POSTGRESQL ===
DB_NAME=opendte_db
DB_USER=opendte_user
DB_PASSWORD=opendte_password
DB_HOST=localhost
DB_PORT=5432
